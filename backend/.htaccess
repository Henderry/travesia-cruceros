# Reescritura de URLs: todo lo que no sea un archivo existente pasa por index.php
RewriteEngine On

# Apache no entrega el encabezado Authorization a PHP por defecto; esto lo habilita (JWT)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
